{
  "name": "dogsplayingpoker-server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node build.js",
    "start": "node dist/index.js",
    "db:extensions": "tsx src/db/ensureExtensions.ts",
    "db:push": "pnpm db:extensions && drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "pnpm db:extensions && drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "test": "vitest",
    "test:db:push": "dotenv -e .env.test -- drizzle-kit push",
    "lint": "tsc --noEmit && eslint src"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.3",
    "@hono/zod-validator": "^0.8.0",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "date-fns": "^4.4.0",
    "dogsplayingpoker-shared": "workspace:*",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.41.0",
    "hono": "^4.12.21",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.3",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.9.2",
    "@types/pg": "^8.11.11",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.3.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.7"
  }
}